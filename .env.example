# ─────────────────────────────────────────────────────────────
#  Sentry — конфигурация
#  Скопируйте в .env и заполните значения:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Яндекс Мессенджер ────────────────────────────────────────
# Эндпоинт отправки сообщений
YANDEX_MESSENGER_URL=https://ymnb.av.ru/api/messages/send
# OAuth 2.0 токен (передаётся как Authorization: Bearer <token>)
YANDEX_MESSENGER_TOKEN=
# ID чата, куда слать уведомления (формат вида 0/0/<uuid>)
YANDEX_MESSENGER_CHAT_ID=

# ── Яндекс Трекер ────────────────────────────────────────────
TRACKER_URL=https://tracker.yandex.ru

# ── Защита эндпоинтов (настоятельно рекомендуется) ───────────
# Если задано — запросы к /webhook, /api/v1/log, /api/v1/clear,
# /api/v1/test-notify требуют заголовок:  X-Webhook-Token: <значение>
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=

# ── Хранилище ────────────────────────────────────────────────
# Путь к файлу SQLite. В Docker переопределён на /app/data/... (том).
DB_PATH=data/sentry.db
# Сколько дней хранить события аналитики (для дашборда). 0 = не чистить.
EVENTS_RETENTION_DAYS=365

# ── Параметры сервиса ────────────────────────────────────────
# Окно поиска дублей, минут
WINDOW_MINUTES=30
# Сколько последних записей держать в каждом логе (incoming / duplicate)
MAX_LOG_ENTRIES=200
# Сдвиг часового пояса для вывода времени (МSK = 3)
TIMEZONE_OFFSET=3

# Порт на хосте (внутри контейнера всегда 8000)
PORT=8000
