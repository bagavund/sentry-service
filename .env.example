# ─────────────────────────────────────────────────────────────
#  Sentry — конфигурация
#  Скопируйте в .env и заполните значения:  cp .env.example .env
#
#  Почти всё отсюда после первого старта можно менять в админке
#  (http://<host>:8000/admin) — значения из БД имеют приоритет над .env.
#  .env задаёт начальные значения и то, что нужно ещё до старта:
#  ADMIN_PASSWORD, DB_PATH, PORT, LOG_*.
# ─────────────────────────────────────────────────────────────

# ── Админка ──────────────────────────────────────────────────
# Пароль для входа в /admin. Пусто = вход в админку отключён.
# Сменить потом можно в самой админке («Общие настройки»).
ADMIN_PASSWORD=

# ── Яндекс Мессенджер (значения по умолчанию для очередей) ────
YANDEX_MESSENGER_URL=https://ymnb.av.ru/api/messages/send
# OAuth 2.0 токен (Authorization: Bearer <token>). Общий для всех очередей;
# у очереди может быть свой токен, заданный в админке.
YANDEX_MESSENGER_TOKEN=
# Чат для очереди по умолчанию (формат 0/0/<uuid>). Остальные очереди
# получают свой chat_id в админке.
YANDEX_MESSENGER_CHAT_ID=

# ── Яндекс Трекер ────────────────────────────────────────────
TRACKER_URL=https://tracker.yandex.ru

# ── Защита вебхука ───────────────────────────────────────────
# Общий токен. Если задан — /webhook и служебные ручки требуют
# заголовок  X-Webhook-Token: <значение>.  У очереди может быть свой токен.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=

# ── Очереди ──────────────────────────────────────────────────
# Ключ очереди, которую слушает legacy-эндпоинт POST /webhook (без пути).
DEFAULT_QUEUE_KEY=default
# Начальные значения для очереди по умолчанию и формы «новая очередь».
WINDOW_MINUTES=30
ALERT_THRESHOLD=1

# ── Хранилище ────────────────────────────────────────────────
DB_PATH=data/sentry.db
EVENTS_RETENTION_DAYS=365
MAX_LOG_ENTRIES=200
TIMEZONE_OFFSET=3

# ── Логирование ──────────────────────────────────────────────
LOG_LEVEL=INFO
# Каталог файла лога. Пусто = каталог файла БД (тот же том в Docker).
LOG_DIR=
LOG_FILE=sentry.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ── Сеть ─────────────────────────────────────────────────────
# Порт на хосте (внутри контейнера всегда 8000)
PORT=8000
